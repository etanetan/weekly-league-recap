# Copy to .env.local and fill in values. Variables prefixed with
# NEXT_PUBLIC_ are inlined into client bundles at build time.

# --- Required for AI recap generation -----------------------------------
# Gemini API key. Free tier works.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Supabase (auth + saved leagues + recap history) --------------------
# Required for signed-in flows (saved leagues, history, dashboard).
# In NODE_ENV !== "production", the app degrades to a logged-out-only
# mode when these are unset — recap generation still works for the
# anonymous flow. Production builds always require these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anonymous rate limiting (optional) ---------------------------------
# Upstash Redis credentials for the 3-recaps-per-day cap on anonymous
# users. If unset, every anonymous request is allowed (helpful for local
# dev / CLI testing).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
